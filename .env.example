# Copia este archivo como .env y completa los valores reales.
# Nunca subas el archivo .env (con claves reales) al repositorio.

# --- Firebase (Auth + Firestore) ---
# Consola de Firebase > Configuración del proyecto > Tus apps > SDK de Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- EmailJS ---
# Panel de EmailJS > Account > General (Public Key) y Email Services / Email Templates.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_VERIFICATION=
VITE_EMAILJS_TEMPLATE_PASSWORD_RESET=
VITE_EMAILJS_TEMPLATE_ORDER_CONFIRMATION=

# --- Administración ---
# Correos extra con acceso al panel de administración, separados por comas.
# senoraysenorcafetintacafetinta@gmail.com ya tiene acceso de administrador
# por defecto (ver src/app/services/authGateway.js), no es necesario repetirlo aquí.
VITE_ADMIN_EMAILS=
